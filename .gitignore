# Secrets and runtime state - never commit these
secrets/
store/
logs/

# Personal deployment notes: real hostnames, LAN address, tunnel id, token URLs.
# The tracked template is personal.example/; copy it to personal/ on a machine.
personal/

# Portable tooling downloaded at runtime (git / gh / cloudflared)
tools/

# Node
node_modules/
npm-debug.log*

# Local config overrides
config.json
*.local.json

# OS noise
Thumbs.db
.DS_Store
desktop.ini
